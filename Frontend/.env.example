VITE_API_URL=http://localhost:5000

# AWS Cognito Identity Pool — gives the kiosk browser temporary, unauthenticated
# AWS credentials so AWS Amplify's <FaceLivenessDetector> can stream directly
# to Rekognition. Never put a static AWS access key/secret in frontend code —
# this Identity Pool is the safe substitute for that.
VITE_AWS_REGION=ap-south-1
VITE_AWS_IDENTITY_POOL_ID=
